# Existing application settings
FRONTEND_URL=https://your-frontend-domain.example
MONGO_URI=
JWT_SECRET=

# Web Push: generate once with `npx web-push generate-vapid-keys` and keep
# the private key secret. HTTPS is required in production.
VAPID_SUBJECT=mailto:admin@your-domain.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
